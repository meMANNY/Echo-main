/* ============================================================================
   Echo — one cohesive QSS pass (Session 9, plan Q7).
   Applied app-wide in app.py via app.setStyleSheet(). Widget-level inline
   styles (status colours, the top bar, progress-row frames) intentionally
   override this base chrome for the few places that carry live state.
   ============================================================================ */

/* Base typography + text colour. Deliberately NO blanket background here, so
   frames/dividers keep their intended look. */
QWidget {
    font-family: "Segoe UI", "Helvetica Neue", Arial, sans-serif;
    font-size: 13px;
    color: #2c3e50;
}

QMainWindow, QDialog {
    background-color: #eef1f5;
}

QLabel {
    background: transparent;
    color: #2c3e50;
}

/* --- Buttons -------------------------------------------------------------- */
QPushButton {
    background-color: #ffffff;
    border: 1px solid #cdd4dc;
    border-radius: 6px;
    padding: 6px 14px;
    color: #2c3e50;
}
QPushButton:hover {
    background-color: #f0f6ff;
    border-color: #3b82f6;
}
QPushButton:pressed {
    background-color: #e2edfd;
}
QPushButton:disabled {
    background-color: #f2f3f5;
    color: #a9b2bd;
    border-color: #e1e5ea;
}
/* Primary / default action (Send, Save, etc.) */
QPushButton:default {
    background-color: #3b82f6;
    border-color: #3b82f6;
    color: #ffffff;
    font-weight: 600;
}
QPushButton:default:hover {
    background-color: #2f6fe0;
}
QPushButton:default:pressed {
    background-color: #295fc4;
}
QPushButton:default:disabled {
    background-color: #a9c6f6;
    border-color: #a9c6f6;
    color: #eef4ff;
}

/* --- Text inputs ---------------------------------------------------------- */
QLineEdit, QTextEdit {
    background-color: #ffffff;
    border: 1px solid #cdd4dc;
    border-radius: 6px;
    padding: 5px 8px;
    selection-background-color: #3b82f6;
    selection-color: #ffffff;
}
QLineEdit:focus, QTextEdit:focus {
    border: 1px solid #3b82f6;
}
QLineEdit:disabled, QTextEdit:disabled {
    background-color: #f2f3f5;
    color: #a9b2bd;
}

/* --- Lists & trees -------------------------------------------------------- */
QListWidget, QTreeWidget {
    background-color: #ffffff;
    border: 1px solid #dcdde1;
    border-radius: 6px;
    outline: 0;
}
QListWidget::item, QTreeWidget::item {
    padding: 4px 2px;
    border-radius: 4px;
}
QListWidget::item:selected, QTreeWidget::item:selected {
    background-color: #e2edfd;
    color: #1c3d6e;
}
QTreeWidget::item:hover, QListWidget::item:hover {
    background-color: #f4f8ff;
}
QHeaderView::section {
    background-color: #f4f6f8;
    color: #55606d;
    padding: 5px 6px;
    border: none;
    border-bottom: 1px solid #dcdde1;
    font-weight: 600;
}

/* --- Progress bars (transfer rows) --------------------------------------- */
QProgressBar {
    background-color: #eceff3;
    border: 1px solid #dcdde1;
    border-radius: 6px;
    text-align: center;
    height: 18px;
    color: #2c3e50;
}
QProgressBar::chunk {
    background-color: #3b82f6;
    border-radius: 5px;
}

/* --- Group boxes (Settings dialog) --------------------------------------- */
QGroupBox {
    border: 1px solid #dcdde1;
    border-radius: 6px;
    margin-top: 10px;
    padding: 8px;
    font-weight: 600;
}
QGroupBox::title {
    subcontrol-origin: margin;
    subcontrol-position: top left;
    left: 10px;
    padding: 0 4px;
    color: #55606d;
}

/* --- Checkboxes ----------------------------------------------------------- */
QCheckBox { spacing: 6px; }
QCheckBox::indicator {
    width: 16px; height: 16px;
    border: 1px solid #cdd4dc;
    border-radius: 4px;
    background: #ffffff;
}
QCheckBox::indicator:checked {
    background: #3b82f6;
    border-color: #3b82f6;
}

/* --- Scrollbars (subtle) -------------------------------------------------- */
QScrollBar:vertical {
    background: transparent;
    width: 10px;
    margin: 2px;
}
QScrollBar::handle:vertical {
    background: #c3cbd6;
    border-radius: 5px;
    min-height: 24px;
}
QScrollBar::handle:vertical:hover { background: #a9b4c2; }
QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical { height: 0; }
QScrollBar::add-page:vertical, QScrollBar::sub-page:vertical { background: transparent; }

QScrollBar:horizontal {
    background: transparent;
    height: 10px;
    margin: 2px;
}
QScrollBar::handle:horizontal {
    background: #c3cbd6;
    border-radius: 5px;
    min-width: 24px;
}
QScrollBar::handle:horizontal:hover { background: #a9b4c2; }
QScrollBar::add-line:horizontal, QScrollBar::sub-line:horizontal { width: 0; }
QScrollBar::add-page:horizontal, QScrollBar::sub-page:horizontal { background: transparent; }

/* --- Scroll area holding the transfer rows -------------------------------- */
QScrollArea { border: 1px solid #dcdde1; border-radius: 6px; background: #fbfcfd; }
